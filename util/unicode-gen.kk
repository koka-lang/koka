/* Generate the Unicode tables used by `std/text/unicode`.

Download `UnicodeData.txt`, `EastAsianWidth.txt`, and `CompositionExclusions.txt`
from <https://www.unicode.org/Public/UCD/latest/ucd/> into a directory `<ucd>`,
and run from the Koka root directory:

> koka -e util/unicode-gen.kk -- <ucd>

This generates `lib/std/text/unicode-tables.kk` (combining marks and column widths)
and `lib/std/text/unicode-tables.c` (canonical tables for NFC/NFD normalization in C).
*/
module unicode-gen

import std/os/path
import std/os/file
import std/os/env

// A code point entry from `UnicodeData.txt`
struct ucd
  code   : int
  cat    : string     // general category
  ccc    : int        // canonical combining class
  decomp : list<int>  // canonical decomposition (empty if none)

alias range = (int,int)

fun hex( s : string ) : int
  s.trim.parse-int(hex=True).default(0)

fun hexs( i : int ) : string
  i.show-hex(4)

// The fields of each data line in a UCD file (ignoring comments)
fun data-lines( dir : path, fname : string ) : <fsys,exn> list<list<string>>
  read-text-file(dir / fname).lines.filter-map fn(line)
    val content = line.split("#").head.default("").trim
    if content.is-empty then Nothing else Just(content.split(";").map(trim))

fun parse-ucd( fields : list<string> ) : maybe<ucd>
  match fields
    Cons(code,Cons(_,Cons(cat,Cons(ccc,Cons(_,Cons(dec,_)))))) ->
      val decomp = if dec.is-empty || dec.starts-with("<").is-just then [] else dec.split(" ").map(hex)
      Just(Ucd(code.hex, cat, ccc.parse-int.default(0), decomp))
    _ -> Nothing

fun parse-range( s : string ) : range
  match s.split("..")
    Cons(lo,Cons(hi,_)) -> (lo.hex,hi.hex)
    _                   -> (s.hex,s.hex)

// Merge adjacent ranges of a sorted list
fun merge( rs : list<range> ) : div list<range>
  match rs
    Cons((lo1,hi1),Cons((lo2,hi2),rest)) | hi1 + 1 == lo2 -> merge(Cons((lo1,hi2),rest))
    Cons(r,rest) -> Cons(r,merge(rest))
    Nil -> Nil

fun ranges( codes : list<int> ) : div list<range>
  codes.map(fn(c) (c,c)).merge

fun msort( xs : list<(int,int,int)> ) : div list<(int,int,int)>
  val n = xs.length
  if n <= 1 then xs else
    val (ys,zs) = xs.split(n / 2)
    merge-sorted(ys.msort, zs.msort)

fun merge-sorted( xs : list<(int,int,int)>, ys : list<(int,int,int)> ) : div list<(int,int,int)>
  match (xs,ys)
    (Cons(x,xx),Cons(y,yy)) ->
      val (x1,x2,_) = x
      val (y1,y2,_) = y
      if x1 < y1 || (x1 == y1 && x2 <= y2) then Cons(x,merge-sorted(xx,ys)) else Cons(y,merge-sorted(xs,yy))
    (Nil,_) -> ys
    _       -> xs


//--------------------------------------------------------------
// Koka range lists
//--------------------------------------------------------------

fun koka-ranges( doc : string, name : string, rs : list<range> ) : div string
  val cells = rs.map(fn(r) "(" ++ r.fst.hexs ++ "," ++ r.snd.hexs ++ ")")
  (["", "// " ++ doc, "pub fun " ++ name ++ "() : list<(int,int)>", "  ["] ++
   cells.chunks(6).map(fn(cs) "    " ++ cs.join(", ") ++ ",") ++
   ["  ]"]).unlines


//--------------------------------------------------------------
// C tables
//--------------------------------------------------------------

fun c-table( doc : string, name : string, columns : int, rows : list<list<string>> ) : div string
  val cells = rows.map(fn(row) "{" ++ row.join(",") ++ "}")
  (["", "// " ++ doc, "static const int32_t " ++ name ++ "[][" ++ columns.show ++ "] = {"] ++
   cells.chunks(6).map(fn(cs) "  " ++ cs.join(", ") ++ ",") ++
   ["};"]).unlines

fun chunks( xs : list<a>, n : int ) : div list<list<a>>
  if xs.is-nil then [] else Cons(xs.take(n), xs.drop(n).chunks(n))


//--------------------------------------------------------------
// Main
//--------------------------------------------------------------

pub fun main()
  val dir = path(get-args().head.default("."))
  val version = match read-text-file(dir / "EastAsianWidth.txt").lines.head.default("").split("-").last
                  Just(v) -> v.split(".txt").head.default(v)
                  Nothing -> "?"
  val header  = "// Generated by util/unicode-gen.kk from the Unicode " ++ version ++ " character database; do not edit."
  val ucds    = data-lines(dir, "UnicodeData.txt").filter-map(parse-ucd)
  val wide    = data-lines(dir, "EastAsianWidth.txt").filter-map fn(fields)
                  match fields
                    Cons(cps,Cons(w,_)) | w == "W" || w == "F" -> Just(cps.parse-range)
                    _ -> Nothing
  val excluded = data-lines(dir, "CompositionExclusions.txt").map(fn(fields) fields.head.default("").hex)

  // combining marks and column widths
  val marks = ucds.filter(fn(u) u.cat.starts-with("M").is-just).map(fn(u) u.code)
  val zeros = ucds.filter(fn(u) (u.cat == "Mn" || u.cat == "Me" || u.cat == "Cf" || u.cat == "Cc") && u.code != 0xAD
                                || (u.code >= 0x1160 && u.code <= 0x11FF)    // Hangul medial vowels and final consonants
                                || (u.code >= 0xD7B0 && u.code <= 0xD7FF)).map(fn(u) u.code)
  write-text-file( path("lib/std/text/unicode-tables.kk"), [
    header,
    "module std/text/unicode-tables",
    koka-ranges("Combining marks (general category `Mn`, `Mc`, or `Me`) as sorted inclusive ranges", "mark-ranges", marks.ranges),
    koka-ranges("Code points with zero column width (non-spacing marks, controls, format characters, and Hangul medial vowels and final consonants)", "zero-width-ranges", zeros.ranges),
    koka-ranges("Code points that are 2 columns wide (East Asian width `W` or `F`)", "wide-ranges", wide.merge),
  ].join("\n"))

  // canonical normalization tables
  val cccs    = ucds.filter(fn(u) u.ccc != 0).map(fn(u) (u.code,u.ccc))
  fun ccc-of(c : int) : int
    cccs.lookup(fn(d) d == c).default(0)
  val decomps = ucds.filter(fn(u) u.decomp.is-cons)
  val comps   = decomps.filter-map fn(u)
                  match u.decomp
                    Cons(d1,Cons(d2,Nil)) | !excluded.any(fn(x) x == u.code) && u.ccc == 0 && d1.ccc-of == 0 -> Just((d1,d2,u.code))
                    _ -> Nothing
  write-text-file( path("lib/std/text/unicode-tables.c"), [
    header,
    c-table("Canonical combining classes: `{code point, class}`", "kk_unicode_ccc", 2,
            cccs.map(fn(c) [c.fst.hexs,c.snd.show])),
    c-table("Canonical decompositions: `{code point, first, second or 0}`", "kk_unicode_decomp", 3,
            decomps.map(fn(u) [u.code, u.decomp.head.default(0), u.decomp.drop(1).head.default(0)].map(hexs))),
    c-table("Primary compositions: `{first, second, composite}` (sorted on the first two)", "kk_unicode_comp", 3,
            comps.msort.map(fn(c) { val (d1,d2,cp) = c; [d1,d2,cp].map(hexs) })),
  ].join("\n"))
  println("generated Unicode " ++ version ++ " tables")
