// A closure parameter is not a reuse donor: its size depends on what it
// captures, not on its result type, so `f` is dropped rather than reused for `Pt`@
pub type parc/parc-closure-reuse/shape[3,1,5,22] {
 pub con parc/parc-closure-reuse/Pt[4,3,4,4](x: int, y: int){0,2,8} : (x : int, y : int) -> parc/parc-closure-reuse/shape = 1;
 pub con parc/parc-closure-reuse/Sz[5,3,5,4](w: int, h: int){0,2,8} : (w : int, h : int) -> parc/parc-closure-reuse/shape = 2;
};
// Automatically generated@ Tests for the `Pt` constructor of the `:shape` type@
pub fip fun is-pt : (^ shape : parc/parc-closure-reuse/shape) -> bool
 = fn(shape: parc/parc-closure-reuse/shape){
 match (shape) {
 (parc/parc-closure-reuse/Pt((@pat@xxx: int), (@pat@xxx: int)) : parc/parc-closure-reuse/shape )
 -> std/core/types/True;
 (@skip parc/parc-closure-reuse/Sz((@pat@xxx: int), (@pat@xxx: int)) : parc/parc-closure-reuse/shape )
 -> std/core/types/False;
 };
 };
// Automatically generated@ Tests for the `Sz` constructor of the `:shape` type@
pub fip fun is-sz : (^ shape : parc/parc-closure-reuse/shape) -> bool
 = fn(shape: parc/parc-closure-reuse/shape){
 match (shape) {
 (parc/parc-closure-reuse/Sz((@pat@xxx: int), (@pat@xxx: int)) : parc/parc-closure-reuse/shape )
 -> std/core/types/True;
 (@skip parc/parc-closure-reuse/Pt((@pat@xxx: int), (@pat@xxx: int)) : parc/parc-closure-reuse/shape )
 -> std/core/types/False;
 };
 };
pub fun pick : (f : () -> parc/parc-closure-reuse/shape, b : bool) -> parc/parc-closure-reuse/shape
 = fn(f: () -> parc/parc-closure-reuse/shape, b: bool){
 match (b) {
 (std/core/types/True() : bool )
 -> val _ : ()
 = std/core/types/@drop(f);
 parc/parc-closure-reuse/Pt(1, 2);
 (@skip std/core/types/False() : bool )
 -> f();
 };
 };